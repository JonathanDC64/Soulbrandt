/* Pause band (looks.hpp): the menus as the game's own pause menu draws its System options screen (docs/148; the looks
   mock-up in docs/151). A band across the top edge holds the page's title and its tabs, with a line about the row
   under it; the rows sit straight on the dimmed game, a section's name in a bracket at their left, a stone bar for the
   setting and a dark box with cut corners for its value; the prompts run in a band near the bottom. In the F1 menu the
   band holds the entries, the chosen one on a blood tile, with the entry's line and the prompts straight under it,
   and the game is not dimmed. Sizes as the game's at 1280 x 720, in dp.

   Everything is inside @media (theme: band), its sprites and keyframes too, named for the look. */

@media (theme: band) {

/* The value box: dark inside a one-pixel warm edge, its corners cut (res/img, tools/ui/make_ui_art.py). */
@spritesheet band-art {
    src: /res/img/valuebox.png;
    resolution: 2x;
    band-box: 0px 0px 24px 24px;
    band-box-inner: 10px 10px 4px 4px;
}

/* The game's motion, measured (docs/151): even speed, no easing. The band drops in from the top edge, 190 px in
   0.2 s; a page slides in from the left, 400 px in 0.17 s; the focus bar breathes. */
@keyframes band-drop {
    from { transform: translateY(-190dp); }
    to { transform: translateY(0dp); }
}

@keyframes band-page-in {
    from { transform: translateX(-400dp); }
    to { transform: translateX(0dp); }
}

@keyframes band-breathe {
    from { opacity: 1; }
    to { opacity: 0.82; }
}

body {
    --band-tan: #c8aa8c;
    --band-tan-light: #e8d6c0;
    --band-tan-muted: #a8927a;
    --band-bracket: #6a665b;
    --band-blood-edge: #a24742;
    --band-amber: #e0a63c;
}

/* ---- The frame: the whole window (Interface > Menu height is Today's: looks.hpp). ---- */
menu-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 0 30dp;
    overflow: visible;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--band-tan);
}

body.entries menu-frame {
    display: flex;
}

body.page menu-frame {
    background-color: rgba(0, 0, 0, 55%);
}

/* ---- The band: the title at its left (the page's, or "Menu" in the F1 menu), the tabs or the entries at its right.
   ---- */
menu-slot {
    display: block;
    flex: 0 0 104dp;
    height: 104dp;
    padding: 40dp 0 0 64dp;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #4f4d46;
    background-color: #2a2a29;
    decorator: linear-gradient(#343432, #272727 60%, #222222), image(/res/img/grain.png repeat left top);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 26dp;
    letter-spacing: 0;
    text-transform: none;
    color: var(--band-tan-light);
}

body.standalone menu-slot {
    display: block;
}

menu-slot-entry {
    display: none;
}

body.page menu-slot-entry.on,
body.entries menu-title,
body.closing menu-title {
    display: block;
    width: 400dp;
    height: 44dp;
    padding: 0 12dp 0 16dp;
    line-height: 42dp;
    border-top-width: 1dp;
    border-top-color: rgba(0, 0, 0, 55%);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(255, 255, 255, 7%);
    decorator: linear-gradient(90deg, #00000073, #0000004d 60%, #00000000);
    color: var(--band-tan-light);
}

menu-entries {
    left: auto;
    right: 48dp;
    top: 41dp;
    width: auto;
    height: 44dp;
    z-index: 2;
    gap: 2dp;
    border-bottom-width: 0;
    background-color: transparent;
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 17dp;
    text-transform: none;
    color: var(--band-tan-muted);
    transform: none;
}

body.page menu-entries,
body.closed menu-entries {
    display: none;
}

menu-entry {
    padding: 0 13dp;
    line-height: 44dp;
    opacity: 1;
}

menu-entry:hover {
    opacity: 1;
    color: var(--band-tan-light);
}

menu-entry.on {
    border-bottom-width: 0;
    border-top-width: 1dp;
    border-top-color: var(--band-blood-edge);
    decorator: linear-gradient(#853432, #6a2524), image(/res/img/grain.png repeat left top);
    font-effect: none;
    color: var(--band-tan-light);
}

menu-close {
    display: none;
}

/* The amber arrows at the entries' ends, dim at the first or last entry. */
menu-end {
    display: block;
    flex: 0 0 22dp;
    font-family: Material Symbols Rounded;
    font-size: 28dp;
    color: var(--band-amber);
    cursor: pointer;
}

menu-end.left {
    decorator: text("&#xe5de;" center center);
}

menu-end.right {
    decorator: text("&#xe5df;" center center);
}

menu-end.end {
    opacity: 0.3;
}

menu-tabs {
    position: absolute;
    left: 476dp;
    right: 48dp;
    top: 41dp;
    height: 44dp;
    justify-content: flex-end;
    gap: 2dp;
    padding: 0;
    overflow: visible;
    border-bottom-width: 0;
}

menu-tab {
    padding: 0 11dp;
    line-height: 44dp;
    border-bottom-width: 0;
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 17dp;
    text-transform: none;
    color: var(--band-tan-muted);
    font-effect: none;
}

menu-tab:hover {
    color: var(--band-tan-light);
}

menu-tab.on {
    background-color: rgba(255, 255, 255, 8%);
    color: var(--band-tan-light);
    font-effect: none;
}

menu-tab-key {
    margin: 0 4dp;
}

menu-tab-key menu-art {
    height: 32dp;
}

/* ---- The line under the band: the entry's, or the row's. A dark seam above it, as the band's shadow. ---- */
menu-strip {
    display: block;
    flex: 0 0 38dp;
    height: 38dp;
    padding: 0 72dp;
    overflow: hidden;
    border-top-width: 3dp;
    border-top-color: #141413;
    border-bottom-width: 1dp;
    border-bottom-color: #45433d;
    background-color: #2c2b2b;
    decorator: image(/res/img/grain.png repeat left top);
    font-size: 17dp;
    line-height: 34dp;
    white-space: nowrap;
}

/* ---- The page: the rows on the dimmed game. ---- */
menu-page {
    padding: 12dp 0 10dp 40dp;
}

body.entries menu-page {
    display: none;
}

menu-body {
    width: 1000dp;
}

menu-rows {
    padding: 0 0 0 0;
}

menu-help {
    display: none;
}

/* A section's name at the rows' left, in a bracket; it takes no height of its own, so its first row sits beside it. */
menu-heading {
    width: 236dp;
    height: 34dp;
    margin: 14dp 0 -34dp;
    padding: 6dp 12dp 0 0;
    border-top-width: 1dp;
    border-right-width: 1dp;
    border-color: var(--band-bracket);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 17dp;
    letter-spacing: 0.5dp;
    text-transform: uppercase;
    text-align: right;
    color: var(--band-tan);
}

menu-heading:first-child {
    margin-top: 0;
}

menu-row {
    height: 34dp;
    margin: 0 0 4dp 250dp;
    padding: 0;
    gap: 12dp;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
}

menu-row:hover,
menu-row.focused {
    background-color: transparent;
}

menu-label {
    flex: 0 0 300dp;
    height: 34dp;
    padding: 0 0 0 4dp;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #141414;
    background-color: #2c2c2b;
    decorator: linear-gradient(#333331, #262626), image(/res/img/grain.png repeat left top);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 21dp;
    text-transform: none;
    color: var(--band-tan);
}

menu-row:hover menu-label {
    color: var(--band-tan-light);
}

menu-row.focused menu-label {
    border-top-color: var(--band-blood-edge);
    decorator: linear-gradient(#853432, #6a2524), image(/res/img/grain.png repeat left top);
    color: var(--band-tan-light);
}

body.motion menu-row.focused menu-label {
    animation: 1.1s linear-in-out infinite alternate band-breathe;
}

/* A row whose list is open: its bar a deeper red while the list has the focus. */
menu-row.listing menu-label {
    decorator: linear-gradient(#5a1d1b, #42110f), image(/res/img/grain.png repeat left top);
}

menu-mark {
    flex: 0 0 20dp;
    color: var(--band-tan-muted);
}

menu-row.waits menu-mark {
    color: var(--band-amber);
}

menu-value {
    flex: 0 0 380dp;
    height: 32dp;
    padding: 0 6dp;
    justify-content: center;
    decorator: ninepatch(band-box, band-box-inner, 5dp);
    font-size: 21dp;
    color: var(--band-tan);
}

menu-value menu-text {
    flex: 1 1 auto;
    text-align: center;
}

menu-row.modified menu-value menu-text {
    font-weight: normal;
    color: var(--band-tan-light);
}

menu-value menu-tag {
    font-size: 14dp;
    color: var(--band-tan-muted);
}

/* A number's share of its range: a tarnish fill inside the box, clear of its cut corners. */
menu-gauge {
    display: block;
    position: absolute;
    left: 3dp;
    right: 3dp;
    top: 3dp;
    bottom: 3dp;
}

menu-fill {
    display: block;
    height: 100%;
    decorator: linear-gradient(#1b4652, #133038 45%, #0e2229);
}

/* The arrows that change the value: the game's small amber triangles at the box's ends, dim at the first or last. */
menu-arrow {
    flex: 0 0 22dp;
    height: 30dp;
    font-size: 30dp;
    color: var(--band-amber);
    opacity: 1;
}

menu-arrow.left {
    margin-right: 0;
    decorator: text("&#xe5de;" center center);
}

menu-arrow.right {
    decorator: text("&#xe5df;" center center);
}

menu-arrow.end,
menu-row.focused.steps menu-arrow.end {
    opacity: 0.3;
}

menu-row.comparing menu-value menu-text {
    color: var(--band-amber);
}

menu-value input {
    border-width: 0;
    background-color: transparent;
    font-size: 21dp;
    text-align: center;
    color: var(--band-tan-light);
}

/* ---- A value's list: beside its box (looks.hpp's listBeside), in the same box, the cursor on a blood bar. ---- */
menu-list {
    left: 704dp;
    right: auto;
    width: 240dp;
    padding: 5dp 3dp;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
    decorator: ninepatch(band-box, band-box-inner, 5dp);
    font-family: Old Standard TT;
}

menu-item {
    padding: 2dp 12dp;
    font-size: 19dp;
    color: var(--band-tan);
}

menu-item menu-tag {
    font-size: 14dp;
    color: var(--band-tan-muted);
}

menu-item:hover {
    background-color: rgba(255, 255, 255, 6%);
}

menu-item.cursor {
    background-color: transparent;
    decorator: linear-gradient(#853432, #6a2524);
    color: var(--band-tan-light);
}

/* ---- Help (H, View, Select): the whole help in a box over the rows. ---- */
body.helping menu-help {
    display: flex;
    position: absolute;
    left: 290dp;
    top: 160dp;
    width: 700dp;
    max-height: 440dp;
    z-index: 7;
    padding: 20dp 26dp;
    border-width: 1dp;
    border-color: #4d4a42;
    background-color: rgba(3, 3, 3, 96%);
}

menu-helpbox h3 {
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 24dp;
    color: var(--band-tan-light);
}

/* ---- The prompts: a band near the bottom; in the F1 menu, straight under the line. ---- */
menu-prompts {
    flex: 0 0 38dp;
    height: 38dp;
    justify-content: flex-start;
    gap: 28dp;
    padding: 0 72dp;
    border-top-width: 1dp;
    border-top-color: #3c3a35;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3a35;
    background-color: #1c1c1c;
    decorator: image(/res/img/grain.png repeat left top);
    font-size: 17dp;
}

/* A question's up: the prompts give way to its answers. */
body.asking menu-prompts {
    opacity: 0;
}

body.motion menu-prompts {
    transition: opacity 0.1s linear-in-out;
}

body.entries menu-prompts {
    flex-basis: 40dp;
    height: 40dp;
    border-top-width: 3dp;
    border-top-color: #141413;
}

menu-prompt {
    gap: 7dp;
}

menu-prompt:hover menu-says {
    color: var(--band-tan-light);
}

menu-glyph menu-art {
    height: 26dp;
}

/* ---- The preview: the game's top level at the top edge, the row inside the band, the row's line and the prompts
   under it. ---- */
body.preview menu-frame {
    height: auto;
    max-width: none;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

body.preview menu-page {
    flex: 0 0 0dp;
    padding: 0;
}

body.preview menu-strip {
    margin-top: 64dp;
}

body.preview menu-peek {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 64dp;
    padding: 15dp 0 0 64dp;
    border-bottom-width: 1dp;
    border-bottom-color: #4f4d46;
    background-color: #2a2a29;
    decorator: linear-gradient(#343432, #272727 60%, #222222), image(/res/img/grain.png repeat left top);
}

menu-peek-row {
    justify-content: flex-start;
}

menu-peek-row menu-name {
    display: block;
    width: 300dp;
    height: 34dp;
    padding-left: 24dp;
    line-height: 32dp;
    border-top-width: 1dp;
    border-top-color: var(--band-blood-edge);
    decorator: linear-gradient(#853432, #6a2524), image(/res/img/grain.png repeat left top);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 21dp;
    text-transform: none;
    color: var(--band-tan-light);
}

menu-peek-row menu-value {
    flex: 0 0 380dp;
    min-width: 0;
    border-radius: 0;
    background-color: transparent;
    font-size: 21dp;
}

menu-peek-prev,
menu-peek-next {
    position: absolute;
    left: 784dp;
    width: 400dp;
    font-size: 14dp;
    color: var(--band-tan-muted);
}

menu-peek-prev {
    top: 10dp;
}

menu-peek-next {
    top: 34dp;
    text-align: left;
}

menu-peek-line {
    display: none;
}

/* ---- Compare's line and the notes: over the line under the band, in its style. ---- */
menu-badge {
    left: 0;
    top: 107dp;
    bottom: auto;
    width: 100%;
    height: 36dp;
    padding: 0 72dp;
    transform: none;
    border-width: 1dp 0;
    border-color: #45433d;
    border-radius: 0;
    background-color: #2c2b2b;
    decorator: image(/res/img/grain.png repeat left top);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 17dp;
    line-height: 34dp;
    letter-spacing: 0;
    text-transform: none;
    color: var(--band-tan-light);
}

menu-badge.now {
    color: var(--band-tan-light);
}

body.preview menu-badge {
    top: 64dp;
}

/* ---- A question (modal.hpp, ui::ask): the game's message box, dark with a warm hairline; the answers stone bars,
   the one with the focus on blood. Every question takes it, the crash windows' too. ---- */
window.modal {
    max-width: 520dp;
    border-width: 1dp;
    border-color: #4d4a42;
    border-radius: 0;
    box-shadow: none;
    background-color: rgba(3, 3, 3, 96%);
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--band-tan);
}

window.modal.danger {
    border-width: 1dp;
    border-color: #4d4a42;
}

window.modal modal-dialog {
    padding: 26dp 30dp 24dp;
    gap: 12dp;
}

window.modal modal-header icon {
    display: none;
}

window.modal modal-title,
window.modal.danger modal-title {
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 21dp;
    text-transform: none;
    color: var(--band-tan-light);
}

window.modal modal-body {
    font-size: 16dp;
    color: var(--band-tan-muted);
}

window.modal modal-actions {
    justify-content: center;
    gap: 18dp;
    padding-top: 10dp;
}

window.modal button.modal-btn {
    flex: 0 0 200dp;
    height: 34dp;
    padding: 0;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #141414;
    border-radius: 0;
    box-shadow: none;
    opacity: 1;
    background-color: #2c2c2b;
    decorator: linear-gradient(#333331, #262626), image(/res/img/grain.png repeat left top);
    font-family: Old Standard TT;
    font-size: 17dp;
    letter-spacing: 1.5dp;
    line-height: 32dp;
    text-transform: uppercase;
    color: var(--band-tan);
}

window.modal button.modal-btn:hover,
window.modal button.modal-btn:focus-visible {
    border-top-color: var(--band-blood-edge);
    box-shadow: none;
    decorator: linear-gradient(#853432, #6a2524), image(/res/img/grain.png repeat left top);
    color: var(--band-tan-light);
}

/* ---- Motion (body.motion), the game's: the band and its lines drop in from the top edge when the menu opens (once:
   opening a page keeps them), a page slides in from the left, and on closing the band and its lines go back up the
   same way, in the F1 menu's shape (the page is already closed). ---- */
body.entries.motion menu-frame,
body.page.motion menu-frame,
body.entries.motion menu-entries {
    animation: 0.2s linear-in-out band-drop;
}

body.page.motion menu-body {
    animation: 0.17s linear-in-out band-page-in;
}

body.closing menu-frame,
body.closing menu-entries {
    display: flex;
    transform: translateY(-190dp);
    transition: transform 0.2s linear-in-out;
}

}
