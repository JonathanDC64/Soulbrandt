/* DeS UI (looks.hpp): the menus as the game's own pause menu draws its System options screen (docs/148; the looks
   mock-up in docs/151). A band across the top edge holds the page's title and its tabs, with a line about the row
   under it; the rows sit straight on the dimmed game, a section's name in a bracket at their left, a stone bar for the
   setting and a dark box with cut corners for its value; the prompts run in a band near the bottom. In the F1 menu the
   band holds the entries, the chosen one on a blood tile, with the entry's line and the prompts straight under it,
   and the game is not dimmed. Sizes as the game's at 1280 x 720, in dp.

   The bands span the window; what is on them keeps to a centred column (--menu-column), the room each side of it
   being --menu-side (the shell works it out: menu_shell.cpp). The rows are centred on their bars and boxes, the
   sections' brackets hanging at their left.

   Every decorator list puts the grain first: RmlUi draws a list's first decorator on top.

   Everything is inside @media (theme: des), its sprites and keyframes too, named for the look. */

@media (theme: des) {

/* The value box: dark inside a one-pixel warm edge, its corners cut (res/img, tools/ui/make_ui_art.py). */
@spritesheet des-art {
    src: /res/img/valuebox.png;
    resolution: 2x;
    des-box: 0px 0px 24px 24px;
    des-box-inner: 10px 10px 4px 4px;
}

/* The game's motion, measured (docs/151): even speed, no easing. The band drops in from the top edge, 190 px in
   0.2 s; a page slides in from the left, 400 px in 0.17 s; the focus bar breathes. */
@keyframes des-drop {
    from { transform: translateY(-190dp); }
    to { transform: translateY(0dp); }
}

@keyframes des-page-in {
    from { transform: translateX(-400dp); }
    to { transform: translateX(0dp); }
}

@keyframes des-breathe {
    from { opacity: 1; }
    to { opacity: 0.82; }
}

/* What waits for the player (Change Buttons' box while it waits for the input): it holds, dips and comes back. */
@keyframes des-blink {
    0% { opacity: 1; }
    40% { opacity: 1; }
    70% { opacity: 0.4; }
    100% { opacity: 1; }
}

/* (--menu-room, menu.rcss's 1280dp, holds the column and its 64dp sides, where the list and the notes beside a row
   reach: 52dp past the column.) */
body {
    --menu-column: 1152dp;
    --menu-side: 64dp;
    --des-tan: #c8aa8c;
    --des-tan-light: #e8d6c0;
    --des-tan-muted: #a8927a;
    --des-bracket: #6a665b;
    --des-blood-edge: #a24742;
    --des-amber: #e0a63c;
    --des-amber-light: #ffd27a;
    --des-hover-edge: #8a7c66;
    --des-locked: #7d7264;
    /* Status, and nothing else, has colour (docs/148, widened by decision 21): the HUD's stamina, health and magic
       bars, and the amber of the arrows. */
    --des-ok: #6e9d4c;
    --des-warn: #e0a63c;
    --des-error: #c4433b;
    --des-info: #5b8fd6;
}

/* ---- The frame: the whole window (Interface > Menu height is Alpha UI's: looks.hpp). ---- */
menu-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 0 30dp;
    overflow: visible;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--des-tan);
}

body.entries menu-frame {
    display: flex;
}

body.page menu-frame {
    background-color: rgba(0, 0, 0, 68%);
}

/* ---- The band: the title at its left (the page's, or "Menu" in the F1 menu), the tabs or the entries at its right.
   ---- */
menu-slot {
    display: block;
    position: static;
    flex: 0 0 104dp;
    height: 104dp;
    padding: 40dp 0 0 var(--menu-side);
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #4f4d46;
    background-color: #2a2a29;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#343432, #272727 60%, #222222);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 26dp;
    letter-spacing: 0;
    text-transform: none;
    color: var(--des-tan-light);
}

menu-slot-entry,
menu-title,
menu-slot-close {
    display: none;
}

/* A page over another (Change Buttons over Settings) names itself in the slot, in the entry's place. */
body.over menu-slot-entry.on {
    display: none;
}

menu-slot-entry.on,
body.over menu-title {
    display: block;
    width: 400dp;
    height: 44dp;
    padding: 0 12dp 0 16dp;
    line-height: 42dp;
    border-top-width: 1dp;
    border-top-color: rgba(0, 0, 0, 55%);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(255, 255, 255, 7%);
    decorator: linear-gradient(90deg, #00000073, #0000004d 60%, #00000000);
    color: var(--des-tan-light);
}

menu-entries {
    left: auto;
    right: var(--menu-side);
    top: 41dp;
    width: auto;
    height: 44dp;
    z-index: 2;
    gap: 2dp;
    border-bottom-width: 0;
    background-color: transparent;
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 17dp;
    text-transform: none;
    color: var(--des-tan-muted);
    transform: none;
}

body.page menu-entries,
body.closed menu-entries {
    display: none;
}

/* The entries drop in with the band (des-drop, under Motion at the end). Alpha UI's transition on their transform
   (menu.rcss) is off here: RmlUi starts no animation on a property a transition already moves, so the entries stood
   in place while the band dropped in under them. (Closing sets its own transition: body.closing.) */
body.motion menu-entries {
    transition: none;
}

menu-entry {
    margin: 9dp 0;
    padding: 0 13dp;
    line-height: 26dp;
    border-top-width: 1dp;
    border-top-color: transparent;
    opacity: 1;
}

menu-entry:hover {
    opacity: 1;
    border-top-color: var(--des-hover-edge);
    background-color: rgba(255, 255, 255, 6%);
    color: var(--des-tan-light);
}

menu-entry.on {
    border-bottom-width: 0;
    border-top-width: 1dp;
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
    font-effect: none;
    color: var(--des-tan-light);
}

menu-close {
    display: none;
}

/* The entries' ends: the buttons that move along them, as Settings' tabs have (dim at the first or last entry). */
menu-end {
    display: flex;
    align-items: center;
    margin: 0 4dp;
    cursor: pointer;
}

menu-end:hover {
    background-color: rgba(255, 255, 255, 10%);
}

menu-end menu-art {
    height: 32dp;
}

menu-end.end {
    opacity: 0.35;
    background-color: transparent;
    cursor: default;
}

menu-tabs {
    position: absolute;
    left: auto;
    right: var(--menu-side);
    top: 41dp;
    height: 44dp;
    justify-content: flex-end;
    gap: 2dp;
    padding: 0;
    overflow: visible;
    border-bottom-width: 0;
}

menu-tab {
    margin: 9dp 0;
    padding: 0 11dp;
    line-height: 26dp;
    border-top-width: 1dp;
    border-top-color: transparent;
    border-bottom-width: 0;
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 17dp;
    text-transform: none;
    color: var(--des-tan-muted);
    font-effect: none;
}

menu-tab:hover {
    border-top-color: var(--des-hover-edge);
    background-color: rgba(255, 255, 255, 6%);
    color: var(--des-tan-light);
}

menu-tab.on {
    border-top-color: #5a574f;
    background-color: rgba(255, 255, 255, 14%);
    color: var(--des-tan-light);
    font-effect: none;
}

menu-tab-key {
    display: block;
    margin: 0 4dp;
    cursor: pointer;
}

/* (the tab buttons are at the tabs' ends: not in the prompts) */
menu-prompt.tabs {
    display: none;
}

menu-tab-key:hover {
    background-color: rgba(255, 255, 255, 10%);
}

menu-tab-key menu-art {
    height: 32dp;
}

/* ---- The line under the band: the entry's, or the row's. A dark seam above it, as the band's shadow. ---- */
menu-strip {
    display: block;
    flex: 0 0 38dp;
    height: 38dp;
    padding: 0 var(--menu-side);
    overflow: hidden;
    border-top-width: 3dp;
    border-top-color: #141413;
    border-bottom-width: 1dp;
    border-bottom-color: #45433d;
    background-color: #2c2b2b;
    decorator: image(/res/img/grain.png repeat left top);
    font-size: 17dp;
    line-height: 34dp;
    white-space: nowrap;
}

/* ---- The page: the rows on the dimmed game. ---- */
menu-page {
    padding: 12dp 0 10dp;
}

/* The rows' scroll bar: a thin line just right of the value boxes (the rows end there; the body runs on for the help
   Alpha UI shows beside them). */
menu-rows {
    flex: 0 0 1032dp;
}

menu-rows scrollbarvertical,
menu-rows scrollbarvertical slidertrack {
    width: 4dp;
    margin: 0;
}

menu-rows scrollbarvertical slidertrack {
    background-color: rgba(0, 0, 0, 45%);
}

menu-rows scrollbarvertical sliderbar {
    width: 4dp;
    border-radius: 0;
    background-color: var(--des-bracket);
}

menu-rows scrollbarvertical sliderbar:hover,
menu-rows scrollbarvertical sliderbar:active {
    background-color: var(--des-tan);
}

/* (closing too: the menu leaves in the F1 menu's shape. The page, empty by then, would take the frame's height and put
   the prompts at the window's bottom, where they would ride up over the game.) */
body.entries menu-page,
body.closing menu-page {
    display: none;
}

menu-body {
    flex: 1 1 auto;
    align-self: center;
    width: 1152dp;
}

menu-rows {
    padding: 0 0 0 0;
}

menu-help {
    display: none;
}

/* A section's name at the rows' left, in a bracket down the whole section (menu-bracket, as long as its rows); it takes
   no height of its own, so its first row sits beside it. */
menu-heading {
    position: relative;
    width: 186dp;
    height: 34dp;
    margin: 14dp 0 -34dp;
    padding: 6dp 12dp 0 0;
    border-top-width: 1dp;
    border-color: var(--des-bracket);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 17dp;
    letter-spacing: 0.5dp;
    text-transform: uppercase;
    text-align: right;
    color: var(--des-tan);
}

menu-heading:first-child {
    margin-top: 0;
}

menu-bracket {
    display: block;
    position: absolute;
    right: 0;
    top: -1dp;
    width: 0;
    height: 34dp;
    border-right-width: 1dp;
    border-color: var(--des-bracket);
}

menu-row {
    height: 34dp;
    margin: 0 0 4dp 200dp;
    padding: 0;
    gap: 12dp;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
}

menu-row:hover,
menu-row.focused {
    background-color: transparent;
}

menu-label {
    flex: 0 0 370dp;
    height: 34dp;
    padding: 0 0 0 4dp;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #141414;
    background-color: #2c2c2b;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 21dp;
    letter-spacing: 0.3dp;
    text-transform: none;
    color: var(--des-tan);
}

menu-row:hover menu-label {
    border-top-color: var(--des-hover-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4c4a45, #393835);
    color: var(--des-tan-light);
}

menu-row:hover menu-value menu-text {
    color: var(--des-tan-light);
}

menu-row.focused menu-label {
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
    color: var(--des-tan-light);
}

body.motion menu-row.focused menu-label {
    animation: 1.1s linear-in-out infinite alternate des-breathe;
}

menu-row.locked menu-label,
menu-row.locked:hover menu-label {
    border-top-color: #3a3833;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#292927, #212120);
    color: var(--des-locked);
    opacity: 1;
}

menu-row.locked.focused menu-label {
    border-top-color: #5e3532;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4a2826, #3a1f1e);
    color: #a8968a;
}

body.motion menu-row.locked.focused menu-label {
    animation: none;
}

menu-row.locked menu-value {
    opacity: 1;
}

menu-row.locked menu-value menu-text,
menu-row.locked menu-value icon.lock {
    color: var(--des-locked);
}

/* A row whose list is open: its bar a deeper red while the list has the focus. */
menu-row.listing menu-label {
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#5a1d1b, #42110f);
}

/* (no spacing in an icon's name: Material Symbols draws it as one glyph) */
menu-mark,
menu-value icon {
    letter-spacing: 0;
}

menu-mark {
    flex: 0 0 20dp;
    color: var(--des-tan-muted);
}

menu-row.waits menu-mark {
    color: var(--des-tan);
}

menu-value {
    flex: 0 0 370dp;
    height: 32dp;
    padding: 0 6dp;
    justify-content: space-between;
    decorator: ninepatch(des-box, des-box-inner, 5dp);
    font-size: 21dp;
    letter-spacing: 0.3dp;
    color: var(--des-tan);
}

/* (positioned, so they draw over the number's fill, which is; too long for the box, it ends in an ellipsis) */
menu-value menu-text {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
}

menu-value menu-arrow,
menu-value icon {
    position: relative;
}

/* A colour's swatch and its value, together in the middle of the box. */
menu-value menu-swatch {
    margin-left: auto;
    border-color: var(--des-tan-muted);
    border-radius: 0;
}

menu-value menu-swatch + menu-text {
    flex: 0 1 auto;
    margin-right: auto;
}

menu-row.modified menu-value menu-text {
    font-weight: normal;
    color: var(--des-tan-light);
}

/* The tag just past the box's right end, so the value keeps the whole box and its middle (a list or the aside opening
   there covers it). */
menu-value menu-tag {
    position: absolute;
    left: 100%;
    right: auto;
    top: 0;
    margin-left: 10dp;
    line-height: 32dp;
    font-size: 14dp;
    letter-spacing: 0;
    white-space: nowrap;
    color: var(--des-tan-muted);
}

/* An empty text (Custom server, Online name): what that means, in the tag's colour. */
menu-row.text menu-value menu-text:empty {
    decorator: text("Not set" #8f8270 center center);
}

/* A row that opens something: what Enter does, in the box, as the game's own buttons on a row (in place of Alpha UI's
   chevron). */
menu-row.action menu-value menu-text {
    display: block;
}

menu-row.action menu-arrow.right,
menu-row.action.focused menu-arrow.right {
    display: none;
}

/* A number's share of its range: a tarnish fill inside the box, clear of its cut corners. */
menu-gauge {
    display: block;
    position: absolute;
    left: 3dp;
    right: 3dp;
    top: 3dp;
    bottom: 3dp;
}

menu-fill {
    display: block;
    height: 100%;
    decorator: linear-gradient(#1b4652, #133038 45%, #0e2229);
}

/* The arrows that change the value: the game's small amber triangles at the box's ends, dim at the first or last. */
menu-arrow {
    flex: 0 0 22dp;
    height: 30dp;
    font-size: 30dp;
    color: var(--des-amber);
    opacity: 1;
}

menu-arrow.left {
    margin-right: 0;
    decorator: text("&#xe5de;" center center);
}

menu-arrow.right {
    decorator: text("&#xe5df;" center center);
}

menu-arrow:hover {
    color: var(--des-amber-light);
}

menu-arrow.end,
menu-row.focused.steps menu-arrow.end {
    opacity: 0.3;
    color: var(--des-amber);
}

menu-row.comparing menu-value menu-text {
    color: var(--des-tan-light);
}

menu-value input {
    border-width: 0;
    background-color: transparent;
    font-size: 21dp;
    text-align: center;
    color: var(--des-tan-light);
}

/* ---- A value's list: beside its box (looks.hpp's listBeside), in the same box, the cursor on a blood bar. (On its
   row: the start screen's list of choices is a menu-list too.) It lies past the rows' scroll box, as the aside does,
   so it isn't clipped by it once the rows scroll (the page keeps it inside the rows' height). ---- */
menu-row menu-list {
    left: 764dp;
    right: auto;
    clip: none;
    width: auto;  /* (as wide as its longest value, a tag with it; the page keeps it in the window) */
    min-width: 240dp;
    padding: 5dp 3dp;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
    decorator: ninepatch(des-box, des-box-inner, 5dp);
    font-family: Old Standard TT;
}

menu-item {
    padding: 5dp 14dp;
    font-size: 21dp;
    color: var(--des-tan);
}

menu-item menu-tag {
    font-size: 14dp;
    color: var(--des-tan-muted);
}

menu-item menu-swatch {
    border-color: var(--des-tan-muted);
    border-radius: 0;
}

menu-item:hover {
    background-color: rgba(255, 255, 255, 14%);
    color: var(--des-tan-light);
}

menu-item.cursor {
    background-color: transparent;
    decorator: linear-gradient(#853432, #6a2524);
    color: var(--des-tan-light);
}

/* A choice that can't be taken here: the locked rows' colour, with no light under the pointer. */
menu-item.disabled,
menu-item.disabled:hover {
    opacity: 1;
    background-color: transparent;
    color: var(--des-locked);
}

menu-item.disabled.cursor {
    decorator: linear-gradient(#4a2422, #3a1c1b);
}

/* ---- Beside the focused row (settings_page.cpp's aside), where its list opens: why it is as it is now and a stick's
   picture, in the list's box. It lies past the rows' scroll box, so it isn't clipped by it (the page keeps it inside
   the rows' height). ---- */
menu-row menu-aside {
    display: block;
    position: absolute;
    left: 764dp;
    top: 0;
    z-index: 5;
    clip: none;
    width: 240dp;
    padding: 12dp 14dp;
    decorator: ninepatch(des-box, des-box-inner, 5dp);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 16dp;
    line-height: 22dp;
    text-transform: none;
    color: var(--des-tan);
    cursor: default;
}

body.helping menu-aside {
    display: none;
}

menu-aside menu-notes status-badge,
menu-helpbox menu-notes status-badge {
    display: block;
    margin-bottom: 8dp;
    font-size: 16dp;
    line-height: 22dp;
    color: var(--des-tan);
}

menu-aside menu-notes status-badge.warning,
menu-helpbox menu-notes status-badge.warning {
    color: var(--des-amber);
}

menu-aside stick-preview {
    flex-direction: column;
    align-items: center;
    gap: 10dp;
    margin: 0;
}

stick-ring {
    border-color: var(--des-bracket);
}

stick-zone {
    border-color: rgba(200, 170, 140, 50%);
    background-color: rgba(200, 170, 140, 12%);
}

stick-dot {
    background-color: var(--des-tan-light);
}

stick-dot.game {
    background-color: var(--des-amber);
}

stick-legend {
    font-size: 15dp;
    line-height: 21dp;
    color: var(--des-tan);
}

/* ---- Help (H, View, Select): the whole help in a box over the rows. ---- */
body.helping menu-help {
    display: flex;
    position: absolute;
    left: 50%;
    top: 220dp;
    width: 700dp;
    margin-left: -350dp;
    max-height: 420dp;
    z-index: 7;
    padding: 24dp 30dp;
    border-width: 1dp;
    border-color: #4d4a42;
    background-color: #030303;
    box-shadow: #000000 0 0 0 1dp;
}

menu-helpbox h3 {
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 21dp;
    color: var(--des-tan-light);
}

menu-helpbox menu-helptext {
    font-size: 17dp;
    line-height: 26dp;
    color: var(--des-tan);
}

menu-helpbox menu-facts {
    padding-top: 14dp;
    font-size: 17dp;
    color: var(--des-tan-muted);
}

menu-helpbox menu-fact {
    justify-content: flex-start;
    gap: 0;
    padding: 3dp 0;
}

menu-helpbox menu-fact-name {
    flex: 0 0 96dp;
}

menu-helpbox menu-fact-value,
menu-helpbox menu-fact-value.key {
    font-size: 17dp;
    letter-spacing: 0;
    color: var(--des-tan-light);
}

/* ---- The prompts: a band near the bottom; in the F1 menu, straight under the line. ---- */
menu-prompts {
    flex: 0 0 38dp;
    height: 38dp;
    justify-content: flex-start;
    gap: 20dp;
    padding: 0 var(--menu-side);
    border-top-width: 1dp;
    border-top-color: #3c3a35;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3a35;
    background-color: #1c1c1c;
    decorator: image(/res/img/grain.png repeat left top);
    font-size: 17dp;
}

/* A question's up: the prompts give way to its answers. */
body.asking menu-prompts {
    opacity: 0;
}

body.motion menu-prompts {
    transition: opacity 0.1s linear-in-out;
}

body.entries menu-prompts,
body.closing menu-prompts {
    flex-basis: 40dp;
    height: 40dp;
    border-top-width: 3dp;
    border-top-color: #141413;
}

menu-prompt {
    gap: 7dp;
    padding: 0 6dp;
    cursor: pointer;
}

menu-prompt:hover {
    background-color: rgba(255, 255, 255, 10%);
}

/* (a prompt without words shares the next one's: L1 R1 Scroll) */
menu-prompt.joined {
    margin-right: -16dp;
}

menu-prompt:hover menu-says {
    color: var(--des-tan-light);
}

menu-glyph menu-art {
    height: 26dp;
}

/* ---- The preview: the game's top level at the top edge, the row inside the band, the row's line and the prompts
   under it. ---- */
body.preview menu-frame {
    height: auto;
    max-width: none;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

body.preview menu-page {
    flex: 0 0 0dp;
    padding: 0;
}

body.preview menu-strip {
    margin-top: 64dp;
}

body.preview menu-peek {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 64dp;
    padding: 15dp 0 0 var(--menu-side);
    border-bottom-width: 1dp;
    border-bottom-color: #4f4d46;
    background-color: #2a2a29;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#343432, #272727 60%, #222222);
}

menu-peek-row {
    justify-content: flex-start;
}

menu-peek-row menu-name {
    display: block;
    width: 370dp;
    height: 34dp;
    padding-left: 24dp;
    line-height: 32dp;
    border-top-width: 1dp;
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 21dp;
    text-transform: none;
    color: var(--des-tan-light);
}

menu-peek-row menu-value {
    flex: 0 0 370dp;
    min-width: 0;
    border-radius: 0;
    background-color: transparent;
    font-size: 21dp;
}

menu-peek-prev,
menu-peek-next {
    position: absolute;
    left: 850dp;
    width: 300dp;
    margin-left: var(--menu-side);
    font-size: 14dp;
    color: var(--des-tan-muted);
}

menu-peek-prev {
    top: 10dp;
}

menu-peek-next {
    top: 30dp;
    text-align: left;
}

menu-peek-line {
    display: none;
}

/* ---- Compare's line and the notes: over the line under the band, in its style. ---- */
menu-badge {
    left: 0;
    top: 107dp;
    bottom: auto;
    width: 100%;
    height: 36dp;
    padding: 0 var(--menu-side);
    transform: none;
    border-width: 1dp 0;
    border-color: #45433d;
    border-radius: 0;
    background-color: #2c2b2b;
    decorator: image(/res/img/grain.png repeat left top);
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 17dp;
    line-height: 34dp;
    letter-spacing: 0;
    text-transform: none;
    color: var(--des-tan-light);
}

menu-badge.now {
    color: var(--des-tan-light);
}

body.preview menu-badge {
    top: 64dp;
}

/* ---- A question (modal.hpp, ui::ask): the game's message box, dark with a warm hairline; the answers stone bars,
   the one with the focus on blood. Every question takes it, the crash windows' too. ---- */
window.modal {
    max-width: 700dp;
    border-width: 1dp;
    border-color: #4d4a42;
    border-radius: 0;
    box-shadow: #000000 0 0 0 1dp;
    background-color: #030303;
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--des-tan);
}

window.modal.danger {
    border-width: 1dp;
    border-color: #4d4a42;
}

window.modal modal-dialog {
    padding: 26dp 30dp 24dp;
    gap: 12dp;
}

window.modal modal-header icon {
    display: none;
}

/* The crash window keeps its red mark (questions have none): the HUD's health red, a status colour. */
window.modal modal-header icon.error {
    display: inline-block;
    width: 24dp;
    height: 24dp;
    margin-right: 10dp;
    font-size: 24dp;
    color: var(--des-error);
}

window.modal modal-title,
window.modal.danger modal-title {
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 21dp;
    text-transform: none;
    color: var(--des-tan-light);
}

window.modal modal-body {
    font-size: 17dp;
    line-height: 26dp;
    color: var(--des-tan);
}

/* A question's line that must stand out: the title's lighter tan, in the body's own weight. */
window.modal modal-body modal-warning {
    font-weight: normal;
    color: var(--des-tan-light);
}

/* The line a warning leads with, the first thing read (the co-op mods warning): on its own, larger, in the warning's
   amber. */
window.modal modal-body modal-alert {
    display: block;
    margin: 0 0 12dp;
    font-size: 21dp;
    line-height: 29dp;
    font-weight: bold;
    color: var(--des-warn);
}

window.modal modal-actions {
    justify-content: center;
    gap: 18dp;
    padding-top: 10dp;
}

window.modal button.modal-btn {
    flex: 0 0 200dp;
    height: 34dp;
    padding: 0;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #141414;
    border-radius: 0;
    box-shadow: none;
    opacity: 1;
    background-color: #2c2c2b;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
    font-family: Old Standard TT;
    font-size: 17dp;
    letter-spacing: 0.5dp;
    line-height: 32dp;
    text-transform: uppercase;
    color: var(--des-tan);
}

window.modal button.modal-btn:not(:disabled):hover {
    border-top-color: var(--des-hover-edge);
    box-shadow: none;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4c4a45, #393835);
    color: var(--des-tan-light);
}

window.modal button.modal-btn:not(:disabled):focus-visible {
    border-top-color: var(--des-blood-edge);
    box-shadow: none;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
    color: var(--des-tan-light);
}

/* A question with named answers (Report a player, Public address, Your co-op characters): the answers as rows, as the
   game's lists, and the last, Cancel, as the small stone button under them. */
window.modal modal-actions.vertical {
    flex-flow: column;
    align-items: stretch;
    gap: 6dp;
    padding-top: 12dp;
}

window.modal modal-actions.vertical button.modal-btn {
    flex: 0 0 38dp;
    height: 38dp;
    padding: 0 14dp;
    font-size: 21dp;
    line-height: 36dp;
    letter-spacing: 0.3dp;
    text-align: left;
    text-transform: none;
}

window.modal modal-actions.vertical button.modal-btn:last-child {
    flex: 0 0 34dp;
    align-self: center;
    width: 200dp;
    height: 34dp;
    margin-top: 18dp;
    padding: 0;
    font-size: 17dp;
    line-height: 32dp;
    letter-spacing: 0.5dp;
    text-align: center;
    text-transform: uppercase;
}

window.modal button.modal-btn:disabled {
    border-top-color: #33312d;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#262625, #1e1e1d);
    color: #5f574d;
    opacity: 1;
}

/* A tick (ack.cpp) as a settings row: its line on a stone bar, its state (No, Yes) in a box beside it. */
window.modal button.ack-tick {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12dp;
    width: 100%;
    height: 34dp;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    box-shadow: none;
    background-color: transparent;
    font-family: Old Standard TT;
    font-size: 21dp;
    text-align: left;
    color: var(--des-tan);
}

window.modal button.ack-tick icon {
    display: none;
}

window.modal button.ack-tick tick-label {
    display: block;
    flex: 1 1 auto;
    height: 34dp;
    padding-left: 12dp;
    line-height: 32dp;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #141414;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
}

window.modal button.ack-tick:hover tick-label {
    border-top-color: var(--des-hover-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4c4a45, #393835);
    color: var(--des-tan-light);
}

window.modal button.ack-tick:focus-visible tick-label {
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
    color: var(--des-tan-light);
}

window.modal button.ack-tick tick-value {
    display: block;
    flex: 0 0 170dp;
    height: 32dp;
    line-height: 32dp;
    text-align: center;
    decorator: ninepatch(des-box, des-box-inner, 5dp);
    color: var(--des-tan-light);
}

/* ---- The start screen (prelaunch.cpp), as the game's title menu: our logo where the game's logo stands, the choices
   as centred lines with a blood smear behind the chosen one, the hint and the version as the title's small lines, and
   the prompts at the foot. Behind it, on black (the game booting behind shows nothing through, not even its own
   notices), smoke rises and churns, drawn live (fog_shader.hpp's "start"): black at the top over the title, and black
   again behind the choices, fading out around them. The black at the top fades out by 51.4% of the height, just past
   the logo, so the smoke round the logo stays as dim as it was picked (with the logo 17 dp higher, over a fade to 49%).
   ---- */
body.prelaunch prelaunch-gradient {
    background-color: #000;
    decorator: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0%) 51.4%),
        radial-gradient(ellipse 420dp 290dp at 50% 50%, #000 0%, rgba(0, 0, 0, 0%) 100%),
        shader("fog:start");
}

body.prelaunch prelaunch-vignette {
    decorator: radial-gradient(farthest-corner at 50% 45%, rgba(0, 0, 0, 0%) 30%, rgba(0, 0, 0, 50%) 100%);
}

/* The smoke off (Settings > Interface > Start screen smoke): plain black. The fades and the vignette darken only the
   smoke, so they go with it. */
body.prelaunch.no-smoke prelaunch-gradient,
body.prelaunch.no-smoke prelaunch-vignette {
    decorator: none;
}

body.prelaunch menu {
    left: 0;
    width: 100%;
    align-items: center;
    top: 46%;
    gap: 30dp;  /* (a little above the middle: room for a seventh choice, Update, above the hint) */
}

/* (prelaunch.rcss's --start-room: QUIT clears the hint by 5 dp at 688 dp of height. With Update shown, 720 dp: the
   choices sit at 46% for it, so it fits a 16:9 window at 100% as it did.) */
body.prelaunch {
    --start-room: 688dp;
}

body.prelaunch.update-found {
    --start-room: 720dp;
}

body.prelaunch hero {
    align-items: center;
    gap: 12dp;
}

/* The logo as wide as the choices, white as it was drawn: it stands where the game's own white logo does. A cold flame
   rises off its letters (flame_shader.hpp's "logo"), a shader over the padding box: 60 dp round the logo (its map's)
   and 100 dp more above for the flame to rise into. The negative margins take the padding back out of the layout. The
   letters, an image on the content box, are drawn over the flame, a touch tinted toward its light. Its width and height
   are the letters' own (content-box: global.rcss makes every box border-box, which would take the padding out of them
   and leave the letters no room). */
body.prelaunch hero title-logo {
    box-sizing: content-box;
    width: 440dp;
    height: 156dp;
    padding: 160dp 60dp 60dp 60dp;
    margin: -160dp -60dp -60dp -60dp;
    image-color: #f7fbff;
    decorator: image(/res/img/soulbrandt-logo.png) content-box, shader("flame:logo") padding-box;
}

/* The flame off (Settings > Interface > Soul flame): the letters alone. */
body.prelaunch.no-flame hero title-logo {
    decorator: image(/res/img/soulbrandt-logo.png) content-box;
}

body.prelaunch title-rule {
    display: none;
}

body.prelaunch menu-list {
    align-items: center;
    gap: 2dp;
}

body.prelaunch #menu-list button {
    width: 440dp;
    height: 40dp;
    padding: 0;
    border-left-width: 0;
    text-align: center;
    font-family: Old Standard TT;
    font-weight: normal;
    font-size: 23dp;
    line-height: 40dp;
    letter-spacing: 2.5dp;
    color: var(--des-tan);
    font-effect: glow(0dp 3dp 0dp 0dp rgba(0, 0, 0, 85%));
    /* The chosen one's smear, fully clear: the same gradient, so the choice change fades it in and out (prelaunch.rcss's
       transition). RmlUi can't blend a gradient with none or with one of other stops; it skips those frames. */
    decorator: radial-gradient(ellipse 190dp 12dp at center, rgba(178, 34, 30, 0%) 0%, rgba(150, 24, 22, 0%) 45%,
        rgba(110, 16, 14, 0%) 100%);
}

/* A new version: a stone bar at the top right, as the notes over the game, its mark amber and the bar breathing so it
   isn't missed; the Update choice amber. */
body.prelaunch update-note.on {
    top: 32dp;
    right: 40dp;
    gap: 14dp;
    padding: 12dp 22dp 13dp 14dp;
    border-width: 0;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #111111;
    border-radius: 0;
    box-shadow: #000000 0 0 0 1dp;
    background-color: #2c2c2b;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
}

body.prelaunch update-note.on:hover {
    border-top-color: var(--des-hover-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4c4a45, #393835);
}

body.motion update-note.on {
    animation: 1.1s linear-in-out infinite alternate des-breathe;
}

body.prelaunch update-mark {
    width: 44dp;
    height: 44dp;
    font-size: 32dp;
    color: var(--des-amber);
}

body.prelaunch update-title {
    font-family: Old Standard TT;
    font-size: 21dp;
    line-height: 28dp;
    color: var(--des-tan-light);
}

body.prelaunch update-line {
    font-family: Old Standard TT;
    font-size: 16dp;
    line-height: 22dp;
    color: var(--des-tan);
}

body.prelaunch #menu-list button.update {
    color: var(--des-amber-light);
}

/* A choice that can't be taken now: the locked rows' colour. The pointer doesn't pick it, so it never has the smear. */
body.prelaunch #menu-list button:disabled {
    opacity: 1;
    color: var(--des-locked);
}

/* The chosen one: on the blood smear the game draws behind its choice. The pointer picks a choice as Up and Down do
   (prelaunch.cpp), so it has no look of its own for the pointer. */
body.prelaunch #menu-list button:not(:disabled):focus-visible {
    color: #f6ebdc;
    font-effect: glow(0dp 3dp 0dp 0dp rgba(40, 0, 0, 90%));
    decorator: radial-gradient(ellipse 190dp 12dp at center, rgba(178, 34, 30, 92%) 0%, rgba(150, 24, 22, 55%) 45%,
        rgba(110, 16, 14, 0%) 100%);
}

body.prelaunch hint-info,
body.prelaunch version-info {
    left: 0;
    right: auto;
    width: 100%;
    text-align: center;
    font-family: Old Standard TT;
    font-size: 17dp;
    color: var(--des-tan);
}

body.prelaunch hint-info {
    bottom: 128dp;
}

body.prelaunch version-info {
    bottom: 100dp;
    color: var(--des-tan-muted);
}

body.prelaunch prelaunch-prompts {
    display: flex;
    position: absolute;
    left: 0;
    bottom: 34dp;
    width: 100%;
    height: 38dp;
    justify-content: center;
    align-items: center;
    gap: 22dp;
    font-family: Old Standard TT;
    font-size: 17dp;
    color: var(--des-tan);
}

body.prelaunch menu-prompt {
    display: flex;
    align-items: center;
    height: 34dp;
}

body.prelaunch menu-glyph {
    display: flex;
    align-items: center;
    gap: 2dp;
}

body.prelaunch menu-glyph menu-key {
    display: none;
}

/* ---- A list that goes on past its box (Trophies'): an amber mark on the box's edge, at the top or the bottom, as the
   game marks its item strip. ---- */
list-more {
    display: none;
    position: absolute;
    left: 50%;
    width: 22dp;
    height: 14dp;
    margin-left: -11dp;
    font-family: var(--font-family-icons);
    font-size: 44dp;
    line-height: 14dp;
    text-align: center;
    color: var(--des-amber);
}

list-more.on {
    display: block;
}

list-more.up {
    top: -8dp;
    decorator: text("&#xe5c7;" center center);  /* arrow_drop_up */
}

list-more.down {
    bottom: -8dp;
    decorator: text("&#xe5c5;" center center);  /* arrow_drop_down */
}

/* ---- Trophies (trophies_page.hpp): the list in a box at the column's left, the set's summary in a box at its right,
   each with the game's fine frame. ---- */
trophy-page {
    display: flex;
    flex: 1 1 0dp;
    align-self: center;
    width: 1152dp;
    min-height: 0;
    gap: 22dp;
    padding: 8dp 0 6dp;
}

trophy-box,
trophy-summary {
    position: relative;
    border-width: 1dp;
    border-color: #4d4a42;
    background-color: rgba(0, 0, 0, 62%);
}

trophy-box {
    display: flex;
    flex-flow: column;
    flex: 0 0 744dp;
    align-self: flex-start;
    padding: 6dp 6dp 6dp 8dp;
}

/* (as tall as the whole rows that fit: trophies_page.cpp sets its height) */
trophy-list {
    display: block;
    flex: 0 0 auto;
    overflow: hidden auto;
}

trophy-list scrollbarvertical,
trophy-list scrollbarvertical slidertrack {
    width: 4dp;
    margin: 0;
}

trophy-list scrollbarvertical slidertrack {
    background-color: rgba(0, 0, 0, 45%);
}

trophy-list scrollbarvertical sliderbar {
    width: 4dp;
    border-radius: 0;
    background-color: var(--des-bracket);
}

trophy-row {
    display: flex;
    align-items: center;
    height: 73dp;
    gap: 16dp;
    padding: 0 14dp 0 10dp;
    border-top-width: 1dp;
    border-top-color: transparent;
    border-bottom-width: 1dp;
    border-bottom-color: #2c2a27;
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--des-tan);
    cursor: pointer;
}

trophy-row:hover {
    border-top-color: var(--des-hover-edge);
    background-color: rgba(255, 255, 255, 5%);
}

trophy-row.focused {
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
    color: var(--des-tan-light);
}

body.motion trophy-row.focused {
    animation: 1.1s linear-in-out infinite alternate des-breathe;
}

trophy-icon {
    display: flex;
    flex: 0 0 56dp;
    height: 56dp;
    align-items: center;
    justify-content: center;
    border-width: 1dp;
    border-color: #3d3b35;
    background-color: #0d0d0c;
}

trophy-icon img {
    width: 54dp;
    height: 54dp;
}

trophy-row.locked trophy-icon img {
    image-color: rgba(255, 255, 255, 40%);
}

trophy-icon icon {
    font-size: 32dp;
    color: #8f8a80;
}

trophy-icon.platinum icon { color: #c9d2db; }
trophy-icon.gold icon { color: #d8a83a; }
trophy-icon.silver icon { color: #b9b9b4; }
trophy-icon.bronze icon { color: #b8784a; }

trophy-row.locked trophy-icon icon {
    opacity: 0.42;
}

trophy-text {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
}

trophy-name,
trophy-detail {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

trophy-name {
    font-size: 21dp;
    line-height: 27dp;
    letter-spacing: 0.3dp;
    color: var(--des-tan-light);
}

trophy-detail {
    font-size: 16dp;
    line-height: 22dp;
    letter-spacing: 0.4dp;
    color: var(--des-tan-muted);
}

trophy-row.focused trophy-detail {
    color: var(--des-tan);
}

trophy-tag {
    margin-left: 10dp;
    font-size: 14dp;
    letter-spacing: 0;
    color: var(--des-amber);
}

trophy-meta {
    display: block;
    flex: 0 0 auto;
    text-align: right;
}

trophy-grade {
    display: block;
    font-size: 20dp;
    line-height: 27dp;
    color: var(--des-tan-light);
}

trophy-date {
    display: block;
    font-size: 16dp;
    line-height: 22dp;
    letter-spacing: 0.4dp;
    color: var(--des-tan);
}

trophy-date icon.lock {
    width: 14dp;
    height: 14dp;
    margin: -2dp 6dp 0 0;
    font-size: 13dp;
    decorator: text("&#xe897;" center center);
    color: var(--des-tan-muted);
}

trophy-row.concealed trophy-name {
    color: var(--des-tan);
}

trophy-note {
    display: block;
    padding: 24dp 18dp;
    font-family: Old Standard TT;
    font-size: 18dp;
    line-height: 26dp;
    color: var(--des-tan);
}

icon.trophy-hidden {
    decorator: text("&#xe8f5;" center center);  /* visibility_off */
}

trophy-summary {
    display: block;
    flex: 1 1 auto;
    align-self: flex-start;
    padding: 20dp 22dp 18dp;
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--des-tan);
}

trophy-title {
    display: block;
    font-size: 23dp;
    line-height: 30dp;
    color: var(--des-tan-light);
}

trophy-count {
    display: flex;
    margin: 4dp 0 10dp;
    font-size: 17dp;
    letter-spacing: 0.5dp;
}

count-text {
    flex: 1 1 auto;
}

trophy-summary menu-gauge {
    display: block;
    position: relative;
    height: 12dp;
    border-width: 1dp;
    border-color: #6a665b;
    background-color: #050505;
}

trophy-summary menu-fill {
    display: block;
    height: 100%;
    background-color: #2f5f7a;
    decorator: linear-gradient(#3d7594, #234a60);
}

trophy-grades {
    display: block;
    margin: 18dp 0 0;
    padding: 14dp 0 4dp;
    border-top-width: 1dp;
    border-top-color: #3a3832;
}

trophy-grade-count {
    display: flex;
    align-items: center;
    height: 34dp;
    font-size: 20dp;
    color: var(--des-tan-light);
}

trophy-grade-count icon {
    font-size: 20dp;
    margin-right: 12dp;
}

trophy-grade-count.platinum icon { color: #c9d2db; }
trophy-grade-count.gold icon { color: #d8a83a; }
trophy-grade-count.silver icon { color: #b9b9b4; }
trophy-grade-count.bronze icon { color: #b8784a; }

grade-name {
    flex: 1 1 auto;
}

trophy-hidden {
    display: flex;
    align-items: center;
    margin: 12dp 0 0;
    padding: 14dp 0 0;
    border-top-width: 1dp;
    border-top-color: #3a3832;
    font-size: 16dp;
    letter-spacing: 0.4dp;
}

trophy-hidden icon {
    font-size: 18dp;
    margin-right: 10dp;
    color: var(--des-tan-muted);
}

hidden-name {
    flex: 1 1 auto;
}

hidden-value {
    color: var(--des-tan-muted);
}

body.page.motion trophy-page {
    animation: 0.17s linear-in-out des-page-in;
}

/* ---- Mods (mods_page.hpp): the mods in a framed box at the column's left; the summary (with Restart now under its
   note while a change waits), the focused mod's whole note and the two buttons at its right. With no mods yet, how to
   add one, the buttons under it. ---- */
mods-page {
    display: flex;
    flex: 1 1 0dp;
    align-self: center;
    width: 1152dp;
    min-height: 0;
    gap: 22dp;
    padding: 8dp 0 6dp;
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--des-tan);
}

mods-page.empty {
    flex-flow: column;
    gap: 16dp;
}

mods-box,
mods-summary {
    position: relative;
    border-width: 1dp;
    border-color: #4d4a42;
    background-color: rgba(0, 0, 0, 62%);
}

mods-box {
    display: flex;
    flex-flow: column;
    flex: 0 0 744dp;
    align-self: flex-start;
    max-height: 100%;
    padding: 4dp 6dp 6dp 8dp;
}

mods-page.empty mods-box {
    flex: 0 0 auto;
    width: 744dp;
}

mods-list {
    display: block;
    flex: 0 1 auto;
    min-height: 0;
    overflow: hidden auto;
}

mods-list scrollbarvertical,
mods-list scrollbarvertical slidertrack {
    width: 4dp;
    margin: 0;
}

mods-list scrollbarvertical slidertrack {
    background-color: rgba(0, 0, 0, 45%);
}

mods-list scrollbarvertical sliderbar {
    width: 4dp;
    border-radius: 0;
    background-color: var(--des-bracket);
}

mods-section {
    display: block;
    height: 30dp;
    margin: 4dp 10dp 0;
    border-bottom-width: 1dp;
    border-bottom-color: #3a3832;
    font-size: 17dp;
    line-height: 30dp;
    letter-spacing: 0.5dp;
    color: var(--des-tan-muted);
}

mod-row {
    display: flex;
    align-items: center;
    height: 60dp;
    gap: 16dp;
    padding: 0 12dp 0 12dp;
    border-top-width: 1dp;
    border-top-color: transparent;
    border-bottom-width: 1dp;
    border-bottom-color: #2c2a27;
    cursor: pointer;
}

mod-row:hover {
    border-top-color: var(--des-hover-edge);
    background-color: rgba(255, 255, 255, 5%);
}

mod-row.focused {
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
}

body.motion mod-row.focused {
    animation: 1.1s linear-in-out infinite alternate des-breathe;
}

mod-check {
    display: flex;
    flex: 0 0 28dp;
    justify-content: center;
}

mod-check icon {
    font-size: 26dp;
    color: var(--des-tan-light);
}

mod-row.off mod-check icon {
    color: var(--des-tan-muted);
}

mod-row.problem mod-check icon.warning {
    color: var(--des-warn);
}

mod-row.problem mod-check icon.error {
    color: var(--des-error);
}

/* (on the focus bar's red, a mark keeps its shape in the light colour) */
mod-row.focused mod-check icon,
mod-row.focused mod-line icon {
    color: var(--des-tan-light);
}

mod-text {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
}

mod-name,
mod-line {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

mod-name {
    font-size: 21dp;
    line-height: 26dp;
    letter-spacing: 0.3dp;
    color: var(--des-tan-light);
}

/* (on or off shows once, in the check box; an off mod's name is dimmed) */
mod-row.off mod-name {
    color: var(--des-tan-muted);
}

mod-line {
    font-size: 16dp;
    line-height: 22dp;
    letter-spacing: 0.4dp;
    color: var(--des-tan-muted);
}

mod-row.focused mod-line {
    color: var(--des-tan);
}

mod-line icon {
    width: 15dp;
    height: 15dp;
    margin: -2dp 6dp 0 0;
    font-size: 15dp;
}

mod-line.note icon {
    color: var(--des-info);
}

mod-line.gameplay icon {
    color: var(--des-warn);
}

mod-side {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 14dp;
}

mod-side icon.restart {
    font-size: 20dp;
    color: var(--des-tan-light);
}

mod-move {
    display: none;
    flex-flow: column;
    width: 18dp;
}

mod-row.focused mod-move {
    display: flex;
}

move-up,
move-down {
    display: block;
    height: 14dp;
    font-family: var(--font-family-icons);
    font-size: 34dp;
    line-height: 14dp;
    text-align: center;
    color: var(--des-amber);
}

move-up {
    decorator: text("&#xe5c7;" center center);
}

move-down {
    decorator: text("&#xe5c5;" center center);
}

move-up.none,
move-down.none {
    opacity: 0.2;
}

state-word {
    font-size: 18dp;
    color: var(--des-tan-light);
}

mods-empty {
    display: block;
    padding: 14dp 14dp 10dp;
}

empty-title {
    display: block;
    font-size: 23dp;
    line-height: 30dp;
    color: var(--des-tan-light);
}

empty-lead {
    display: block;
    margin: 2dp 0 10dp;
    font-size: 17dp;
    color: var(--des-tan-muted);
}

empty-step {
    display: block;
    font-size: 18dp;
    line-height: 34dp;
    letter-spacing: 0.4dp;
}

mods-side {
    display: flex;
    flex-flow: column;
    flex: 1 1 auto;
    align-self: flex-start;
    gap: 14dp;
}

mods-page.empty mods-side {
    flex-flow: row;
    flex: 0 0 auto;
}

mods-page.empty mods-summary {
    display: none;
}

mods-summary {
    display: block;
    padding: 18dp 22dp 18dp;
}

summary-line {
    display: block;
    font-size: 23dp;
    line-height: 30dp;
    color: var(--des-tan-light);
}

summary-note {
    display: block;
    margin: 6dp 0 0;
    font-size: 16dp;
    line-height: 23dp;
    letter-spacing: 0.4dp;
}

summary-note icon {
    width: 16dp;
    height: 16dp;
    margin: -2dp 8dp 0 0;
    font-size: 16dp;
}

summary-note.warning icon {
    color: var(--des-tan-light);
}

summary-note.info icon {
    color: var(--des-info);
}

summary-note.offline icon {
    color: var(--des-warn);
}

summary-head {
    display: block;
}

mods-detail {
    display: block;
    margin: 14dp 0 0;
    padding: 14dp 0 0;
    border-top-width: 1dp;
    border-top-color: #3a3832;
    font-size: 16dp;
    line-height: 24dp;
    letter-spacing: 0.4dp;
}

/* Restart now, under the note that asks for it: a button as the two under the box */
mods-summary mods-button.restart {
    margin: 14dp 0 0;
}

mods-button.none,
mods-detail.none {
    display: none;
}

mods-buttons {
    display: flex;
    flex-flow: column;
    gap: 10dp;
}

mods-page.empty mods-buttons {
    flex-flow: row;
}

mods-button {
    display: block;
    height: 38dp;
    padding: 0 22dp;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #141414;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
    font-size: 17dp;
    line-height: 36dp;
    letter-spacing: 1.5dp;
    text-align: center;
    text-transform: uppercase;
    color: var(--des-tan-light);
    cursor: pointer;
}

mods-button:hover {
    border-top-color: var(--des-hover-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4c4a45, #393835);
}

mods-button.focused,
mods-button.close {
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
}

mods-help {
    display: none;
}

mods-help.on {
    display: block;
    position: absolute;
    left: 50%;
    top: 170dp;
    width: 700dp;
    margin-left: -350dp;
    z-index: 7;
    padding: 24dp 30dp 26dp;
    border-width: 1dp;
    border-color: #4d4a42;
    background-color: #030303;
    box-shadow: #000000 0 0 0 1dp;
}

help-title {
    display: block;
    margin: 0 0 10dp;
    font-size: 21dp;
    color: var(--des-tan-light);
}

help-line {
    display: block;
    margin: 0 0 10dp;
    font-size: 17dp;
    line-height: 26dp;
    letter-spacing: 0.4dp;
}

mods-help mods-button.close {
    width: 220dp;
    margin: 16dp auto 0;
}

mods-page icon.info {
    decorator: text("&#xe88e;" center center);
}

mods-page icon.restart {
    decorator: text("&#xe5d5;" center center);
}

mods-page icon.offline {
    decorator: text("&#xe648;" center center);
}

body.page.motion mods-page {
    animation: 0.17s linear-in-out des-page-in;
}

/* ---- Co-op (coop_page.hpp): the System page's tall stone bars in a framed box at the column's left, each with its
   inner line, the chosen one on blood; what co-op is, or the invite code and the players, in a box beside them. ---- */
coop-page {
    display: flex;
    flex: 1 1 0dp;
    align-self: center;
    align-items: flex-start;
    width: 1152dp;
    min-height: 0;
    gap: 20dp;
    padding: 8dp 0 6dp;
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--des-tan);
}

coop-box,
coop-info {
    display: block;
    border-width: 1dp;
    border-color: #4d4a42;
    background-color: rgba(0, 0, 0, 62%);
}

coop-box {
    flex: 0 0 640dp;
    padding: 24dp 22dp 0;
}

coop-action {
    display: block;
    height: 70dp;
    margin: 0 0 24dp;
    padding: 0 26dp;
    border-width: 1dp;
    border-color: #56534b;
    box-shadow: rgba(16, 16, 15, 55%) 0 0 0 6dp inset, #4a4842 0 0 0 7dp inset;
    background-color: #2c2c2b;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
    font-size: 26dp;
    line-height: 68dp;
    letter-spacing: 0.3dp;
    color: var(--des-tan);
    cursor: pointer;
}

coop-action:hover {
    border-color: var(--des-hover-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4c4a45, #393835);
    color: var(--des-tan-light);
}

coop-action.focused {
    border-color: var(--des-blood-edge);
    box-shadow: rgba(66, 17, 15, 45%) 0 0 0 6dp inset, #b0544e 0 0 0 7dp inset;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
    color: var(--des-tan-light);
}

body.motion coop-action.focused {
    animation: 1.1s linear-in-out infinite alternate des-breathe;
}

coop-action.disabled,
coop-action.disabled:hover {
    border-color: #3a3833;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#292927, #212120);
    color: var(--des-locked);
}

coop-action.disabled.focused {
    border-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#5e2a28, #4a1f1e);
    color: var(--des-tan-muted);
}

coop-info {
    flex: 0 0 492dp;
    padding: 14dp 18dp 4dp;
}

coop-info.none {
    display: none;
}

coop-info info-line,
coop-info info-label {
    display: block;
    margin: 0 0 10dp;
    font-size: 17dp;
    line-height: 25dp;
    letter-spacing: 0.3dp;
}

coop-info info-label {
    margin: 0;
    color: var(--des-tan-muted);
}

coop-info info-line.warning {
    color: var(--des-tan-light);
}

coop-info info-code {
    display: block;
    margin: 2dp 0 6dp;
    font-size: 33dp;
    line-height: 40dp;
    letter-spacing: 1.3dp;
    white-space: nowrap;
    color: var(--des-tan-light);
}

coop-info info-lan {
    white-space: nowrap;
    color: var(--des-tan-light);
}

coop-info info-rule {
    display: block;
    height: 1dp;
    margin: 10dp 0 20dp;
    background-color: #3a3833;
}

/* Both codes and the router's line (coop_page.cpp's long): closer together, so the box ends above the prompts. */
coop-info.long info-line {
    margin-bottom: 6dp;
}

coop-info.long info-rule {
    margin: 4dp 0 12dp;
}

coop-info.long info-code {
    margin: 0 0 4dp;
    font-size: 28dp;
    line-height: 34dp;
}

/* A code's line with its small Copy button at the right end: a small stone button, as the questions' buttons. */
coop-info info-head {
    display: flex;
    flex-flow: row nowrap;
    justify-content: space-between;
    align-items: center;
}

coop-info info-head info-line,
coop-info.long info-head info-line {
    margin: 0;
}

coop-info code-copy {
    flex: 0 0 auto;
    margin-left: 12dp;
    height: 24dp;
    padding: 0 12dp;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #141414;
    background-color: #2c2c2b;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
    font-size: 14dp;
    line-height: 22dp;
    letter-spacing: 0.5dp;
    text-transform: uppercase;
    color: var(--des-tan);
    cursor: pointer;
}

coop-info code-copy:hover {
    border-top-color: var(--des-hover-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4c4a45, #393835);
    color: var(--des-tan-light);
}

coop-info code-copy.done {
    color: var(--des-tan-light);
}

body.page.motion coop-page {
    animation: 0.17s linear-in-out des-page-in;
}

/* ---- Change Buttons (controls_page.hpp): Settings' rows, the game's button or action in the stone bar and its input in
   the box beside it; the keys' two inputs in two boxes, the chosen one on blood. A pad button shows as its picture. ---- */
menu-rows.keys {
    flex: 0 0 1152dp;
}

menu-rows.keys menu-value {
    flex: 0 0 275dp;
    justify-content: center;
}

menu-rows.pad menu-value {
    justify-content: center;
}

controls-fill {
    display: none;
}

menu-value.on controls-fill {
    display: block;
    position: absolute;
    left: 3dp;
    right: 3dp;
    top: 3dp;
    bottom: 3dp;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#5a1d1b, #42110f);
}

menu-value.on menu-text {
    color: var(--des-tan-light);
}

menu-value menu-text.none {
    color: var(--des-tan-muted);
}

menu-value.on menu-text.none {
    color: var(--des-tan);
}

menu-value.modified menu-text {
    color: var(--des-tan-light);
}

menu-value.wait menu-text {
    color: var(--des-tan-light);
}

body.motion menu-value.wait menu-text {
    animation: 1s linear-in-out infinite des-blink;
}

controls-art {
    display: block;
    position: relative;
    height: 26dp;
}

controls-art menu-art {
    height: 26dp;
}

menu-rows.pad menu-value menu-text {
    display: none;
}

menu-rows.pad menu-value.wait menu-text {
    display: block;
}

menu-rows.pad menu-value.wait controls-art {
    display: none;
}

/* A pad button with no picture (the Kick's back buttons and paddles, or none): its name. */
menu-rows.pad menu-value.named menu-text {
    display: block;
}

controls-restore {
    display: block;
    width: 300dp;
    height: 34dp;
    margin: 18dp 0 4dp 200dp;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #141414;
    background-color: #2c2c2b;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
    font-size: 17dp;
    line-height: 32dp;
    letter-spacing: 0.5dp;
    text-align: center;
    text-transform: uppercase;
    color: var(--des-tan);
    cursor: pointer;
}

controls-restore:hover {
    border-top-color: var(--des-hover-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4c4a45, #393835);
    color: var(--des-tan-light);
}

controls-restore.focused {
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
    color: var(--des-tan-light);
}

body.motion controls-restore.focused {
    animation: 1.1s linear-in-out infinite alternate des-breathe;
}

controls-restore.locked {
    color: var(--des-locked);
}

/* ---- Players (players_page.hpp): six players at a time in a framed box at the column's left, as Trophies' rows: a
   mark for how you met in a dark tile, with an arrow in its corner for which way; the name, how, and when. ---- */
players-page {
    display: flex;
    flex: 1 1 0dp;
    align-self: center;
    width: 1152dp;
    min-height: 0;
    padding: 8dp 0 6dp;
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--des-tan);
}

players-box {
    display: block;
    position: relative;
    flex: 0 0 744dp;
    align-self: flex-start;
    padding: 6dp 6dp 6dp 8dp;
    border-width: 1dp;
    border-color: #4d4a42;
    background-color: rgba(0, 0, 0, 62%);
}

/* No one to list: the box says what and why (players_page.cpp's draw_empty), as Mods' box does with no mods. */
players-empty {
    display: none;
}

players-page.none players-empty {
    display: block;
    padding: 14dp 14dp 10dp;
}

player-item {
    display: none;
}

player-item.shown {
    display: flex;
    align-items: center;
    height: 73dp;
    gap: 16dp;
    padding: 0 14dp 0 10dp;
    border-top-width: 1dp;
    border-top-color: transparent;
    border-bottom-width: 1dp;
    border-bottom-color: #2c2a27;
    cursor: pointer;
}

player-item.shown:hover {
    border-top-color: var(--des-hover-edge);
    background-color: rgba(255, 255, 255, 5%);
}

player-item.focused {
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
}

body.motion player-item.focused {
    animation: 1.1s linear-in-out infinite alternate des-breathe;
}

player-tile {
    display: block;
    position: relative;
    flex: 0 0 56dp;
    height: 56dp;
    border-width: 1dp;
    border-color: #3d3b35;
    background-color: #0d0d0c;
}

player-tile icon {
    position: absolute;
    left: 11dp;
    top: 11dp;
    width: 32dp;
    height: 32dp;
    font-size: 32dp;
    color: var(--des-tan);
}

player-tile icon.way {
    left: auto;
    top: auto;
    right: 2dp;
    bottom: 2dp;
    width: 16dp;
    height: 16dp;
    font-size: 16dp;
    color: var(--des-tan-light);
}

player-item.blocked player-tile icon {
    color: var(--des-locked);
}

players-page icon.met-help {
    decorator: text("&#xe3e4;" center center);  /* flare: a summon sign */
}

players-page icon.met-invasion {
    decorator: text("&#xf889;" center center);  /* swords */
}

players-page icon.met-monk {
    decorator: text("&#xef55;" center center);  /* local_fire_department */
}

players-page icon.met-blocked {
    decorator: text("&#xe14b;" center center);  /* block */
}

players-page icon.way.in {
    decorator: text("&#xe0b5;" center center);  /* call_received: into your world */
}

players-page icon.way.out {
    decorator: text("&#xe0b2;" center center);  /* call_made: out to theirs */
}

player-words {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
}

player-name,
player-how {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

player-name {
    font-size: 21dp;
    line-height: 27dp;
    letter-spacing: 0.3dp;
    color: var(--des-tan-light);
}

player-item.blocked player-name {
    color: var(--des-tan-muted);
}

player-tag {
    margin-left: 10dp;
    font-size: 14dp;
    letter-spacing: 0;
    color: var(--des-amber);
}

player-how {
    font-size: 16dp;
    line-height: 22dp;
    letter-spacing: 0.4dp;
    color: var(--des-tan-muted);
}

player-item.focused player-how {
    color: var(--des-tan);
}

player-ago {
    display: block;
    flex: 0 0 auto;
    font-size: 16dp;
    letter-spacing: 0.4dp;
    color: var(--des-tan);
}

body.page.motion players-page {
    animation: 0.17s linear-in-out des-page-in;
}

/* ---- The on-screen keyboard (osk_window.hpp): the question box, the text in a value box, the keys small stone keys
   in the PS3 keyboard's rows, the one with the focus on blood; the same keys and buttons as Alpha UI's. ---- */
window.modal.osk {
    max-width: 760dp;
    background-color: #030303;
}

window.modal.osk osk-field {
    align-items: center;
    padding: 6dp 16dp;
    border-width: 0;
    background-color: transparent;
    decorator: ninepatch(des-box, des-box-inner, 5dp);
}

window.modal.osk osk-text {
    font-family: Old Standard TT;
    font-size: 26dp;
    line-height: 36dp;
    color: var(--des-tan-light);
}

window.modal.osk osk-caret {
    background-color: var(--des-tan-light);
}

window.modal.osk osk-count {
    font-family: Old Standard TT;
    font-size: 15dp;
    color: var(--des-tan-muted);
    opacity: 1;
}

window.modal.osk osk-keys,
window.modal.osk osk-row {
    gap: 5dp;
}

window.modal.osk button.osk-key {
    height: 38dp;
    padding: 0;
    border-width: 0;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #141414;
    border-radius: 0;
    box-shadow: none;
    background-color: #2c2c2b;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
    font-family: Old Standard TT;
    font-size: 19dp;
    line-height: 36dp;
    text-transform: none;
    color: var(--des-tan);
}

window.modal.osk button.osk-key.osk-wide,
window.modal.osk button.osk-key.osk-space {
    font-size: 14dp;
    letter-spacing: 0.5dp;
    text-transform: uppercase;
}

window.modal.osk button.osk-key:hover {
    border-top-color: var(--des-hover-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#4c4a45, #393835);
    color: var(--des-tan-light);
}

window.modal.osk button.osk-key:focus-visible {
    border-top-color: var(--des-blood-edge);
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#853432, #6a2524);
    color: var(--des-tan-light);
}

window.modal.osk osk-hints {
    font-family: Old Standard TT;
    font-size: 15dp;
    color: var(--des-tan);
}

window.modal.osk osk-pill {
    border-color: #4d4a42;
    border-radius: 0;
    font-size: 12dp;
    opacity: 1;
    color: var(--des-tan-muted);
}

window.modal.osk osk-hint {
    font-family: Old Standard TT;
    font-size: 15dp;
    color: var(--des-tan-muted);
    opacity: 1;
}

/* ---- Notes over the game (overlay.hpp's toasts): a small stone bar at the top right, as the game's own notes, its
   mark at the left in its status colour (a trophy's picture in a dark tile); it slides in from the right, linear, as
   the menu's pages do. The menu hint sits low in the middle, as a prompt does. ---- */
toast {
    top: 32dp;
    right: 40dp;
    width: 500dp;
    padding: 12dp 18dp 13dp 72dp;
    gap: 2dp;
    border-width: 0;
    border-top-width: 1dp;
    border-top-color: #4f4d46;
    border-bottom-width: 1dp;
    border-bottom-color: #111111;
    border-radius: 0;
    box-shadow: #000000 0 0 0 1dp;
    background-color: #2c2c2b;
    decorator: image(/res/img/grain.png repeat left top), linear-gradient(#333331, #262626);
    font-family: Old Standard TT;
    font-weight: normal;
    color: var(--des-tan);
    transform: translateX(60dp);
    transition: filter transform 0.17s linear-in-out;
}

toast[open] {
    transform: translateX(0dp);
}

toast heading {
    font-family: Old Standard TT;
    font-size: 17dp;
    font-weight: normal;
    line-height: 24dp;
    letter-spacing: 0.3dp;
    text-transform: none;
    color: var(--des-tan-light);
}

toast heading icon {
    display: none;
}

toast message {
    gap: 2dp;
    font-size: 17dp;
    line-height: 24dp;
    letter-spacing: 0.3dp;
    color: var(--des-tan);
}

toast progress {
    display: none;
}

toast-mark {
    display: block;
    position: absolute;
    left: 14dp;
    top: 12dp;
    width: 44dp;
    height: 44dp;
    font-family: var(--font-family-icons);
    font-size: 30dp;
    line-height: 44dp;
    text-align: center;
}

toast-mark.warning {
    color: var(--des-warn);
    decorator: text("&#xe002;" center center);
}

toast-mark.info {
    color: var(--des-info);
    decorator: text("&#xe88e;" center center);
}

toast-mark.done {
    color: var(--des-ok);
    decorator: text("&#xe86c;" center center);
}

toast-mark.menu-notification {
    display: none;
}

/* A trophy: its picture in the mark's place, in a dark tile. */
toast.trophy {
    padding-left: 14dp;
}

toast toast-row {
    gap: 14dp;
    align-items: flex-start;
}

toast toast-icon {
    flex: 0 0 44dp;
    width: 44dp;
    height: 44dp;
    justify-content: center;
    border-width: 1dp;
    border-color: #4d4a42;
    background-color: #0b0b0a;
}

toast toast-icon img,
toast toast-icon icon {
    width: 42dp;
    height: 42dp;
}

toast toast-icon icon {
    font-size: 30dp;
}

toast toast-body {
    gap: 2dp;
    max-width: none;
}

toast.trophy message,
toast.trophy trophy-name {
    font-size: 17dp;
    font-weight: normal;
    color: var(--des-tan);
}

/* (its grade in words, without colour: only status has colour) */
toast.trophy grade,
toast.trophy grade.platinum,
toast.trophy grade.gold,
toast.trophy grade.silver,
toast.trophy grade.bronze {
    font-size: 14dp;
    color: var(--des-tan-muted);
}

/* The menu hint: low in the middle, as a prompt. */
toast.menu-notification {
    top: auto;
    bottom: 64dp;
    left: 50%;
    right: auto;
    width: auto;
    padding: 9dp 20dp;
    transform: translateX(-50%) translateY(20dp);
}

toast.menu-notification[open] {
    transform: translateX(-50%) translateY(0dp);
}

toast.menu-notification b {
    font-weight: normal;
    color: var(--des-tan-light);
}

/* ---- The frame rate counter (overlay.rcss): the game's value box, near black inside a one-pixel warm edge, square;
   tan figures, the graph's line in light tan and its columns in tan, a frame past the line amber (status). ---- */
perf {
    border-color: #3f3f3a;
    border-radius: 0;
    background-color: rgba(3, 3, 3, 82%);
    font-family: Old Standard TT;
    color: var(--des-tan);
}

perf-unit,
perf-low,
perf-scale {
    color: var(--des-tan-muted);
}

/* (Old Standard TT's figures sit high in their line, which keeps room below the baseline for descenders: lowered by
   about an eighth of their size, so they are in the middle of the box) */
perf-rate {
    position: relative;
    top: 2.5dp;
}

perf-low {
    position: relative;
    top: 1.5dp;
}

frame-graph {
    border-bottom-color: #3f3f3a;
    color: rgba(232, 214, 192, 80%);
    image-color: var(--des-warn);
}

/* ---- Motion (body.motion), the game's: the band and its lines drop in from the top edge when the menu opens (once:
   opening a page keeps them), a page slides in from the left, and on closing the band and its lines go back up the
   same way, in the F1 menu's shape (the page is already closed; body.closing in menu-page's and menu-prompts' rules).
   ---- */
body.entries.motion menu-frame,
body.page.motion menu-frame,
body.entries.motion menu-entries {
    animation: 0.2s linear-in-out des-drop;
}

body.page.motion menu-body {
    animation: 0.17s linear-in-out des-page-in;
}

body.closing menu-frame,
body.closing menu-entries {
    display: flex;
    transform: translateY(-190dp);
    transition: transform 0.2s linear-in-out;
}

}

/* A short screen (UI scale 125% or more in a 16:9 window): a smaller logo on the start screen, so its top isn't cut
   off, and its flame's room scaled with it (300 / 440 of the padding). (Still DeS UI only; a block of its own, as
   RmlUi has no @media inside @media.) */
@media (theme: des) and (max-height: 640dp) {
body.prelaunch hero title-logo {
    width: 300dp;
    height: 106dp;
    padding: 109dp 41dp 41dp 41dp;
    margin: -109dp -41dp -41dp -41dp;
}
}
