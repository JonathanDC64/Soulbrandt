/* The start screen. Layout from Dusklight's prelaunch.rcss (CC0) by way of FFCCEOT-Recomp. Adapted for Demon's Souls:
   no background picture (the game boots behind the screen, darkened from the left and at the edges), the title in
   Cinzel over a thin silver rule, and the menu buttons in bone that light up soul-white. Colours from theme.rcss. */
/* --start-room: the window height the screen is laid out for. The UI's scale is never more than the window holds of it
   (prelaunch.cpp's room_height()), so at a UI scale of 125% or more the last choice still clears the hint below:
   5 dp between them at 688 dp, and at 744 dp with a seventh choice (Update). */
body {
    --start-room: 688dp;
    --color-prelaunch-muted: rgba(var(--color-text-rgb), 62%);
    --menu-button-decorator: horizontal-gradient(rgba(var(--color-interactive-rgb), 0%) rgba(var(--color-interactive-rgb), 0%));
    --menu-button-decorator-hover: horizontal-gradient(rgba(var(--color-interactive-rgb), 16%) rgba(var(--color-interactive-rgb), 0%));

    width: 100%;
    height: 100%;
    font-family: var(--font-family-body);
    font-weight: normal;
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    filter: opacity(0);
    transition: filter 0.8s 0.1s linear-in-out;
    z-index: -1;
}

body[open] {
    filter: opacity(1);
}

body.update-found {
    --start-room: 744dp;
}

/* The game shows through on the right; the menu side is near black. */
prelaunch-gradient {
    position: absolute;
    width: 100%;
    height: 100%;
    decorator: linear-gradient(to right, rgba(var(--color-black-rgb), 96%) 0%, rgba(var(--color-black-rgb), 90%) 42%,
        rgba(var(--color-black-rgb), 60%) 72%, rgba(var(--color-black-rgb), 40%) 100%);
}

prelaunch-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    decorator: radial-gradient(farthest-corner at 50% 45%, rgba(var(--color-black-rgb), 0%) 45%,
        rgba(var(--color-black-rgb), 75%) 100%);
}

content {
    display: block;
    width: 100%;
    height: 100%;
    filter: opacity(0);
    transition: filter 0.2s linear-in-out;
}

content[open] {
    filter: opacity(1);
}

menu {
    position: absolute;
    left: 104dp;
    top: 50%;
    transform: translateY(-50%);
    width: 640dp;
    display: flex;
    flex-direction: column;
    gap: 56dp;
}

hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
}

/* The name as its logo: white letters on clear, 1320 x 468 (assets/brand/ has the full-size one). Width over height
   stays 2.82, so the letters keep their shape. 99 dp high, 40 more than the name's line was, so the last choice
   still clears the hint below. */
hero title-logo {
    display: block;
    width: 280dp;
    height: 99dp;
    decorator: image(/res/img/soulbrandt-logo.png);
}

title-rule {
    display: block;
    width: 460dp;
    height: 1dp;
    decorator: horizontal-gradient(rgba(var(--color-border-rgb), 100%) rgba(var(--color-border-rgb), 0%));
}

menu-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: flex-start;
}

/* A new version, so it isn't missed: a note at the top right (a click opens it), and the Update choice in the accent
   colour with a bar at its left. */
update-note {
    display: none;
}

update-note.on {
    display: flex;
    position: absolute;
    top: 40dp;
    right: 48dp;
    align-items: center;
    gap: 16dp;
    padding: 14dp 24dp 14dp 18dp;
    border-width: 2dp;
    border-color: rgb(var(--color-accent-rgb));
    border-radius: var(--radius-window);
    background-color: rgba(var(--color-surface-rgb), 94%);
    box-shadow: rgba(var(--color-accent-rgb), 35%) 0 0 18dp 2dp;
    cursor: pointer;
}

update-note.on:hover {
    background-color: rgba(var(--color-accent-rgb), 18%);
}

update-mark {
    display: block;
    width: 40dp;
    height: 40dp;
    font-family: var(--font-family-icons);
    font-size: 40dp;
    color: rgb(var(--color-accent-rgb));
    decorator: text("&#xe2c4;" center center);  /* file_download */
}

update-text {
    display: block;
}

update-title {
    display: block;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-2xl);
    color: var(--color-white);
}

update-line {
    display: block;
    font-size: var(--font-size-md);
    color: var(--color-prelaunch-muted);
}

#menu-list button.update {
    border-left-color: rgb(var(--color-accent-rgb));
    color: rgb(var(--color-accent-rgb));
}

#menu-list button {
    width: 380dp;
    height: 50dp;
    padding: var(--space-sm) var(--space-lg);
    border-radius: 0dp;
    border-left-width: 2dp;
    border-left-color: rgba(var(--color-interactive-rgb), 0%);
    box-shadow: none;
    background-color: transparent;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 2dp;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-5xl);
    font-weight: normal;
    color: var(--color-text);
    cursor: pointer;
    /* A fully transparent gradient as the default state, otherwise a white flash occurs */
    decorator: var(--menu-button-decorator);
}

#menu-list button:disabled {
    opacity: 0.5;
    cursor: default;
    decorator: var(--menu-button-decorator);
}

#menu-list button.anim-done {
    transition: decorator color border-left-color 0.12s linear-in-out;
}

#menu-list button:not(:disabled):hover,
#menu-list button:not(:disabled):focus-visible {
    color: var(--color-white);
    border-left-color: rgba(var(--color-interactive-rgb), 85%);
    font-effect: glow(0dp 6dp 0dp 0dp rgba(var(--color-interactive-rgb), 35%));
    box-shadow: none;
    background-color: transparent;
    decorator: var(--menu-button-decorator-hover);
}

hint-info {
    position: absolute;
    left: 104dp;
    bottom: 64dp;
    font-size: var(--font-size-md);
    color: var(--color-prelaunch-muted);
}

version-info {
    position: absolute;
    right: 64dp;
    bottom: 64dp;
    text-align: right;
    font-size: var(--font-size-md);
    color: var(--color-prelaunch-muted);
}

/* The prompts for the keys here, for a look that draws them (DeS UI). */
prelaunch-prompts {
    display: none;
}

/* Startup animation */
.intro-item {
    opacity: 0;
    transform: translateY(10dp);
    transition: opacity transform 0.3s 0.1s cubic-in-out;
}

body.animate-in .intro-item {
    opacity: 1;
    transform: translateY(0dp);
}

.delay-0 { transition: opacity transform 0.5s 0.1s cubic-in-out; }
.delay-1 { transition: opacity transform 0.3s 0.3s cubic-in-out; }
.delay-2 { transition: opacity transform 0.3s 0.4s cubic-in-out; }
.delay-3 { transition: opacity transform 0.3s 0.5s cubic-in-out; }
.delay-4 { transition: opacity transform 0.3s 0.6s cubic-in-out; }
.delay-5 { transition: opacity transform 0.3s 0.7s cubic-in-out; }
.delay-6 { transition: opacity transform 0.3s 0.8s cubic-in-out; }
.delay-7 { transition: opacity transform 0.3s 0.9s cubic-in-out; }

/* Without animations (prelaunch.cpp): no fade, no rise. */
body.still,
body.still content,
body.still .intro-item,
body.still #menu-list button.anim-done {
    transition: none;
}
